/target

# ESP32 firmware build output. `.embuild` is where esp-idf-sys unpacks and builds
# ESP-IDF itself, so it is a toolchain cache rather than repo content — see
# esp32/README.md. (`/target` above is root-anchored and does not cover these.)
/esp32/target/
/esp32/.embuild/

# Offline build inputs, produced by scripts/make-offline-bundle.sh. Machine
# state, not repo content — see docs/CONTINUITY.md.
/vendor/
/.cargo/
/spore-offline-*.tar.gz
/spore-offline-*.tar.gz.sha256

# Generated site + its build deps
/_site/
/site/node_modules/
/site/package-lock.json

# Python
__pycache__/
*.pyc

# Local planning and documentation
.HERMES/

# Android build outputs
android/app/src/main/jniLibs/
android/**/build/
android/.gradle/
android/local.properties
android/jni/target/
android/app/src/main/assets/webtransports/

# Flashable firmware images produced by esp32/build.sh --image.
/esp32/*.bin
/esp32/.venv/

# Generated by the ESP-IDF component manager. Regenerated on demand, and only
# meaningful when extra_components are declared — which none are.
/esp32/components_*.lock
